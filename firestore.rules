rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function roleOfCurrentUser() {
      return get(/databases/$(database)/documents/utilizatori/$(request.auth.uid)).data.role;
    }

    function rolOfCurrentUser() {
      return get(/databases/$(database)/documents/utilizatori/$(request.auth.uid)).data.rol;
    }

    function isStaff() {
      return request.auth != null && (
        roleOfCurrentUser() in ["superadmin", "admin", "conducere", "isuls", "dsls", "mmls", "mm", "ssmls", "ssmmls"] ||
        rolOfCurrentUser() in ["superadmin", "admin", "conducere", "isuls", "dsls", "mmls", "mm", "ssmls", "ssmmls"]
      );
    }

    match /cereri/{cerereId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /utilizatori/{userId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId ||
          roleOfCurrentUser() in ["admin", "superadmin"] ||
          rolOfCurrentUser() in ["admin", "superadmin"]
        );

      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && (
          request.auth.uid == userId ||
          roleOfCurrentUser() in ["admin", "superadmin"] ||
          rolOfCurrentUser() in ["admin", "superadmin"]
        );

      allow delete: if false;
    }

    match /invite_codes/{codeId} {
      allow read: if true;
      allow update: if request.auth != null;
    }

    match /notificari/{notificationId} {
      // UI-ul principal nu folosește notificari pentru statusul cererii, dar păstrăm
      // colecția funcțională pentru notificări directe/istorice.
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;

      // Administratorul care creează notificarea trebuie să fie autentificat și
      // să își înscrie propriul UID în actorUid. Acceptăm și rolurile existente.
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && isStaff();

      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

      allow delete: if false;
    }

    match /audit_log/{auditId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isStaff();
    }
  }
}
