// Colecția de notificări existente.
match /notificari/{notificationId} {
  allow read: if request.auth != null
              && resource.data.recipientId == request.auth.uid;

  allow create: if request.auth != null
                && get(/databases/$(database)/documents/utilizatori/$(request.auth.uid)).data.role
                   in ["superadmin", "admin", "conducere", "isuls", "dsls", "mmls", "mm", "ssmls", "ssmmls"];

  allow update: if request.auth != null
                && resource.data.recipientId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

  allow delete: if false;
}

// Audit log: administratorii pot crea/citi evenimente; identitatea actorului
// trebuie sa corespunda utilizatorului autentificat, pentru a preveni spoofing-ul.
match /audit_log/{auditId} {
  allow read: if request.auth != null
              && get(/databases/$(database)/documents/utilizatori/$(request.auth.uid)).data.role
                 in ["superadmin", "admin"];

  allow create: if request.auth != null
                && get(/databases/$(database)/documents/utilizatori/$(request.auth.uid)).data.role
                   in ["superadmin", "admin"]
                && request.resource.data.actorId == request.auth.uid;

  // Curățarea Audit Log este permisă doar Admin/Superadmin.
  allow delete: if request.auth != null
                && get(/databases/$(database)/documents/utilizatori/$(request.auth.uid)).data.role
                   in ["superadmin", "admin"];

  allow update: if false;
}
